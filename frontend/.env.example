# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=/api/v1

# WebSocket Configuration
# Leave empty to auto-derive from API base URL
VITE_WS_BASE_URL=

# JWT Configuration
# Token expiry in minutes (default: 480 = 8 hours)
VITE_JWT_EXPIRY_MINUTES=480

# App Configuration
VITE_APP_ENV=development
VITE_APP_NAME="FleetTrack OS"

# Feature Flags
# Set to "false" to disable WebSocket live updates
VITE_ENABLE_WEB_SOCKET=true